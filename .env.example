# Copy values to your shell environment. The CLI does not automatically source this file.
ATLAS_VAULT=/absolute/path/to/.atlas/vault
ATLAS_API_BASE=https://api.openai.com/v1
ATLAS_MODEL=gpt-4.1-mini
ATLAS_AUDITOR_MODEL=gpt-4.1-mini
ATLAS_API_KEY=
# Required for protected HTTP reads/writes and browser WebSocket access.
ATLAS_TOKEN=
# Browser origins are explicit. Tauri localhost origins are included by default.
ATLAS_ALLOWED_ORIGINS=http://localhost:1430,http://127.0.0.1:1430,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Optional real embedding service. Without it search is lexical.
ATLAS_EMBEDDING_MODEL=
ATLAS_BRAVE_API_KEY=
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_CHAT_IDS=
ATLAS_WHATSAPP_PHONE_ID=
ATLAS_WHATSAPP_TOKEN=
ATLAS_WHATSAPP_API_VERSION=v23.0
